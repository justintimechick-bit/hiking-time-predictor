# Copy to .env for local development. Never commit a populated .env.
# For Community Cloud, use .streamlit/secrets.example.toml in Advanced settings.
AUTH_MODE=streamlit
APP_URL=http://localhost:8501
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Google Web application's client ID; also configure it in Supabase Google Auth.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep this stable across deployments so existing signed models remain usable.
MODEL_SIGNING_KEY=
# Optional server-only secret for explicitly confirmed account/data deletion.
# Normal reads/writes always use the publishable key plus the user's JWT.
SUPABASE_SECRET_KEY=

# Only used with AUTH_MODE=service (the optional two-process deployment):
AUTH_PUBLIC_URL=http://localhost:8000
AUTH_SESSION_DB=.auth/sessions.sqlite3
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AUTH_SESSION_KEY=
COOKIE_SECURE=false

# Disposable-project integration tests only. Never point these at production.
RUN_SUPABASE_INTEGRATION=0
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
